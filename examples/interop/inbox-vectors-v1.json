{
  "version": 1,
  "cases": [
    {
      "name": "count-backpressure-fifo",
      "limits": {
        "max_items": 1,
        "max_bytes": 3,
        "max_per_peer": 1
      },
      "operations": [
        {
          "method": "put",
          "arguments": {
            "peer": "peer",
            "payload_hex": "616263",
            "now_ms": 0,
            "expires_at_ms": 10
          },
          "expected": [
            "queued",
            "resource_admitted",
            1,
            3
          ],
          "payload_hex": null
        },
        {
          "method": "put",
          "arguments": {
            "peer": "peer",
            "payload_hex": "64",
            "now_ms": 0,
            "expires_at_ms": 10
          },
          "expected": [
            "rejected",
            "item_capacity",
            1,
            3
          ],
          "payload_hex": null
        },
        {
          "method": "take",
          "arguments": {
            "now_ms": 1
          },
          "expected": [
            "dequeued",
            "requires_verification",
            0,
            0
          ],
          "payload_hex": "616263"
        },
        {
          "method": "take",
          "arguments": {
            "now_ms": 1
          },
          "expected": [
            "empty",
            "no_current_entry",
            0,
            0
          ],
          "payload_hex": null
        }
      ]
    },
    {
      "name": "expiry-behind-head",
      "limits": {
        "max_items": 2,
        "max_bytes": 2,
        "max_per_peer": 2
      },
      "operations": [
        {
          "method": "put",
          "arguments": {
            "peer": "a",
            "payload_hex": "61",
            "now_ms": 0,
            "expires_at_ms": 20
          },
          "expected": [
            "queued",
            "resource_admitted",
            1,
            1
          ],
          "payload_hex": null
        },
        {
          "method": "put",
          "arguments": {
            "peer": "b",
            "payload_hex": "62",
            "now_ms": 0,
            "expires_at_ms": 10
          },
          "expected": [
            "queued",
            "resource_admitted",
            2,
            2
          ],
          "payload_hex": null
        },
        {
          "method": "put",
          "arguments": {
            "peer": "c",
            "payload_hex": "63",
            "now_ms": 10,
            "expires_at_ms": 20
          },
          "expected": [
            "queued",
            "resource_admitted",
            2,
            2
          ],
          "payload_hex": null
        },
        {
          "method": "take",
          "arguments": {
            "now_ms": 10
          },
          "expected": [
            "dequeued",
            "requires_verification",
            1,
            1
          ],
          "payload_hex": "61"
        },
        {
          "method": "take",
          "arguments": {
            "now_ms": 20
          },
          "expected": [
            "empty",
            "no_current_entry",
            0,
            0
          ],
          "payload_hex": null
        }
      ]
    },
    {
      "name": "rollback-destroys-held-state",
      "limits": {},
      "operations": [
        {
          "method": "put",
          "arguments": {
            "peer": "peer",
            "payload_hex": "61",
            "now_ms": 10,
            "expires_at_ms": 20
          },
          "expected": [
            "queued",
            "resource_admitted",
            1,
            1
          ],
          "payload_hex": null
        },
        {
          "method": "take",
          "arguments": {
            "now_ms": 9
          },
          "expected": [
            "rejected",
            "clock_fault",
            0,
            0
          ],
          "payload_hex": null
        },
        {
          "method": "take",
          "arguments": {
            "now_ms": 11
          },
          "expected": [
            "rejected",
            "closed",
            0,
            0
          ],
          "payload_hex": null
        }
      ]
    },
    {
      "name": "peer-and-byte-quotas",
      "limits": {
        "max_items": 3,
        "max_bytes": 2,
        "max_per_peer": 1
      },
      "operations": [
        {
          "method": "put",
          "arguments": {
            "peer": "a",
            "payload_hex": "61",
            "now_ms": 0,
            "expires_at_ms": 20
          },
          "expected": [
            "queued",
            "resource_admitted",
            1,
            1
          ],
          "payload_hex": null
        },
        {
          "method": "put",
          "arguments": {
            "peer": "a",
            "payload_hex": "62",
            "now_ms": 0,
            "expires_at_ms": 20
          },
          "expected": [
            "rejected",
            "peer_capacity",
            1,
            1
          ],
          "payload_hex": null
        },
        {
          "method": "put",
          "arguments": {
            "peer": "b",
            "payload_hex": "6263",
            "now_ms": 0,
            "expires_at_ms": 20
          },
          "expected": [
            "rejected",
            "byte_capacity",
            1,
            1
          ],
          "payload_hex": null
        },
        {
          "method": "put",
          "arguments": {
            "peer": "b",
            "payload_hex": "62",
            "now_ms": 0,
            "expires_at_ms": 20
          },
          "expected": [
            "queued",
            "resource_admitted",
            2,
            2
          ],
          "payload_hex": null
        }
      ]
    }
  ]
}
