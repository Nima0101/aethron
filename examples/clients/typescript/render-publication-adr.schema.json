{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "decision",
    "constraints",
    "alternatives",
    "sources",
    "limits",
    "c4"
  ],
  "properties": {
    "id": {
      "const": "P33-RENDER-PUBLICATION-001"
    },
    "version": {
      "const": 1
    },
    "status": {
      "const": "accepted-component-only"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "technology",
          "assessment"
        ],
        "properties": {
          "technology": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "c4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "containers",
        "components",
        "code"
      ],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1
        },
        "containers": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
