FROM python:3.13.15-slim-trixie@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-server.lock requirements-vision.lock /tmp/locks/
RUN pip install --no-cache-dir --require-hashes -r /tmp/locks/requirements-server.lock -r /tmp/locks/requirements-vision.lock && rm -rf /tmp/locks
COPY wheels/ /tmp/wheels/
RUN pip install --no-index --find-links /tmp/wheels 'aethron-edge[server,vision]==0.1.0' && rm -rf /tmp/wheels && useradd --system --uid 10001 --home /nonexistent --shell /usr/sbin/nologin aethron
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["aethron-edge"]
