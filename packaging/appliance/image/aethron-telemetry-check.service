[Unit]
Description=AETHRON synthetic signed telemetry boot check
Before=aethron-sil-probe.service

[Service]
Type=oneshot
User=aethron
Group=aethron
ExecStart=/opt/aethron/venv/bin/python -I -B /opt/aethron-sil/telemetry_boot_probe.py check
StateDirectory=aethron-telemetry
StateDirectoryMode=0700
RuntimeDirectory=aethron-telemetry-check
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aethron-telemetry /run/aethron-telemetry-check
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=30s
Restart=no

[Install]
WantedBy=multi-user.target
