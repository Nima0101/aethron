{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "local_domain",
    "issued_at",
    "expires_at",
    "peers"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "local_domain": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])",
      "maxLength": 64
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "remote_domain",
          "policy_sha256",
          "issuers",
          "capabilities"
        ],
        "properties": {
          "remote_domain": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])",
            "maxLength": 64
          },
          "policy_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "issuers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])",
              "maxLength": 64
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "perception.direct.v3",
                "presence.coarse.v2",
                "evidence.offline.v1"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AETHRON offline federation v1 structural profile",
  "$comment": "Structural tooling only; never authentication, execution authority or evidence qualification. The normative federation-v1.md profile additionally requires bounded UTF-8 bytes/depth, rejection of duplicate keys and float lexical forms, canonical bytes, interval limits, externally authenticated pins and caller-trusted time/floors. Federation additionally requires unique remote-domain names distinct from local_domain and runtime bundle/scope verification."
}
