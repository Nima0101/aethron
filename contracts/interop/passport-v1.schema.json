{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "passport_id",
    "issuer",
    "subject_sha256",
    "issued_at",
    "expires_at",
    "assurance",
    "motion_authority",
    "capabilities",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "passport_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])",
      "maxLength": 64
    },
    "issuer": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])",
      "maxLength": 64
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assurance": {
      "const": "self_declared"
    },
    "motion_authority": {
      "const": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "evidence_sha256"
        ],
        "properties": {
          "name": {
            "enum": [
              "perception.direct.v3",
              "presence.coarse.v2",
              "evidence.offline.v1"
            ]
          },
          "evidence_sha256": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "kind",
          "outcome"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "synthetic",
              "recorded",
              "external_unverified"
            ]
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "unknown"
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AETHRON self-declared capability passport v1",
  "$comment": "Structural schema only. The normative passport-v1.md profile additionally requires strict UTF-8 byte/depth bounds, no duplicate fields or float lexical forms, unique capability names and evidence digests, complete evidence references, interval limits, canonical bytes and offline trust/signature checks. Never grants motion authority."
}
