{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "issued_at",
    "expires_at",
    "keys",
    "revoked_passports",
    "revoked_keys",
    "revoked_evidence"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "issuer",
          "public_key",
          "not_before",
          "expires_at",
          "capabilities"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
            "minLength": 64,
            "maxLength": 64
          },
          "issuer": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])",
            "minLength": 1,
            "maxLength": 64
          },
          "public_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
            "minLength": 64,
            "maxLength": 64
          },
          "not_before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "perception.direct.v3",
                "presence.coarse.v2",
                "evidence.offline.v1"
              ]
            }
          }
        }
      }
    },
    "revoked_passports": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "revoked_keys": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
        "minLength": 64,
        "maxLength": 64
      }
    },
    "revoked_evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
        "minLength": 64,
        "maxLength": 64
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AETHRON externally provisioned passport trust policy v1",
  "$comment": "Structural schema only. passport-v1.md requires strict UTF-8 byte/depth bounds, duplicate/float lexical rejection, canonical payload bytes, cross-field integrity, trusted time/revision floors, signature authentication and revocation/expiry checks. Schema validity never grants authority or qualifies evidence."
}
