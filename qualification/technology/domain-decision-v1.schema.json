{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain declaration technology decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "decision",
    "technology",
    "constraints",
    "rationale",
    "source",
    "reopen_when",
    "validation",
    "physical_qualification_passed",
    "alternatives"
  ],
  "properties": {
    "$schema": {
      "const": "./domain-decision-v1.schema.json"
    },
    "version": {
      "const": 1
    },
    "id": {
      "const": "qualification-domain-declarations-v1"
    },
    "decision": {
      "enum": [
        "KEEP",
        "MIGRATE"
      ]
    },
    "technology": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "reopen_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "physical_qualification_passed": {
      "const": false
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "technology",
          "source",
          "assessment"
        ],
        "properties": {
          "technology": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
