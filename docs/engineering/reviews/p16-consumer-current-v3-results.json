  "negative_control_source": "\"\"\"Finite real-call result substitution, never a production source mutation.\"\"\"\nimport dataclasses\nimport json\nimport sys\nimport unittest\nfrom unittest.mock import patch\nimport test_passport_schemas as edge\nimport test_sensor_packets as packet\n\nif not __debug__:\n    raise RuntimeError('optimized_control_forbidden')\nexpected = int(sys.argv[1])\nexperiments = (\n    (edge.interop_bundles, edge.EdgeEvidenceConformance, 'test_exact_binding_and_negative_portable_cases'),\n    (packet, packet.SensorPacketConformance, 'test_real_binding_preserves_every_portable_outcome'),\n)\nreports=[]\nfor owner, case_type, method in experiments:\n    original=owner.verify_task_bundle\n    def changed(*args, _original=original, **kwargs):\n        result=_original(*args, **kwargs)\n        return dataclasses.replace(result, policy_revision=3) if result.status == 'rejected' else result\n    with patch.object(owner, 'verify_task_bundle', changed):\n        result=unittest.TextTestRunner(verbosity=2).run(unittest.TestSuite([case_type(method)]))\n    if owner.verify_task_bundle is not original or result.errors or result.skipped:\n        raise RuntimeError('invalid_control_run')\n    reports.append({'method':method,'failures':len(result.failures),'errors':len(result.errors),'skips':len(result.skipped)})\nif sum(item['failures'] for item in reports)!=expected:\n    raise RuntimeError('unexpected_failure_count')\nprint(json.dumps(reports,sort_keys=True))\n",
