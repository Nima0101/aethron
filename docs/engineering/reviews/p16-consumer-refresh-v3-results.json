  "lifecycle_control_source": "import json, unittest\nfrom unittest.mock import patch\nimport test_passports as tests\nif not __debug__:\n    raise RuntimeError(\"optimized_control_forbidden\")\nreports = []\nfor method, field, value in (\n    (\"test_revocation_rejection_does_not_persist_the_new_policy_floor\", \"minimum_policy_revision\", 3),\n    (\"test_expiry_rejection_does_not_persist_a_trusted_time_floor\", \"minimum_time_s\", 0),\n):\n    original = tests.passports.verify\n    def weakened(*args, **kwargs):\n        kwargs[field] = value\n        return original(*args, **kwargs)\n    with patch.object(tests.passports, \"verify\", weakened):\n        result = unittest.TextTestRunner(verbosity=2).run(unittest.TestSuite([tests.PassportVerificationTests(method)]))\n    if len(result.failures) != 1 or result.errors or result.skipped or tests.passports.verify is not original:\n        raise RuntimeError(\"invalid_control_run\")\n    reports.append({\"method\": method, \"assertion_failures\": len(result.failures), \"errors\": len(result.errors), \"skips\": len(result.skipped), \"restored\": True})\nprint(json.dumps(reports, sort_keys=True))\n",
