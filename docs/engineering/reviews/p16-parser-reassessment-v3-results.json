  "syntax_probe_javascript": "// Syntax observation only; this is not a replacement validator.\nconst fs = require('node:fs');\nconst cases = JSON.parse(fs.readFileSync(process.argv[2], 'utf8')).cases;\nconst results = cases.map(c => {\n  try { JSON.parse(Buffer.from(c.input_hex, 'hex').toString('utf8')); return {name:c.name, syntax_accepted:true}; }\n  catch { return {name:c.name, syntax_accepted:false}; }\n});\nprocess.stdout.write(JSON.stringify({runtime:process.version,results}));\n",
