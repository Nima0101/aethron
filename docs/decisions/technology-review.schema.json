{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped technology review decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "review_order_version",
    "component",
    "source_revision",
    "source_sha256",
    "decision",
    "constraints",
    "comparison",
    "rationale",
    "evidence",
    "limits",
    "revisit",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "review_order_version": {
      "const": 3
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "KEEP",
        "MIGRATE"
      ]
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "comparison": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revisit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
